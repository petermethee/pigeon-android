<!--
  Android ne propose une app comme "app SMS par défaut" que si elle déclare ces 4 éléments :
  réception des SMS, réception des MMS, écran de rédaction, et réponse rapide depuis un appel.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <!-- Afficher le nom des contacts plutôt que leur numéro. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Les tablettes sans carte SIM peuvent quand même installer l'app. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application>

        <!-- Écran des SMS (liste des conversations et fil). -->
        <activity
            android:name="io.element.android.features.sms.impl.SmsActivity"
            android:exported="false"
            android:label="@string/sms_launcher_label"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:taskAffinity="io.github.petermethee.pigeon.sms" />

        <!-- Deuxième icône "Pigeon SMS" sur l'écran d'accueil (provisoire, en attendant le fil fusionné). -->
        <activity-alias
            android:name="io.element.android.features.sms.impl.SmsLauncher"
            android:exported="true"
            android:label="@string/sms_launcher_label"
            android:targetActivity="io.element.android.features.sms.impl.SmsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 1. Réception des SMS (seule l'app par défaut reçoit SMS_DELIVER). -->
        <receiver
            android:name="io.element.android.features.sms.impl.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- 2. Réception des MMS. -->
        <receiver
            android:name="io.element.android.features.sms.impl.MmsWapPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Fin du téléchargement d'un MMS. -->
        <receiver
            android:name="io.element.android.features.sms.impl.MmsDownloadedReceiver"
            android:exported="false" />

        <!-- Fichiers temporaires des MMS, que le service MMS d'Android remplit au téléchargement. -->
        <provider
            android:name="io.element.android.features.sms.impl.MmsFileProvider"
            android:authorities="${applicationId}.mms"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mms_file_paths" />
        </provider>

        <!-- Résultat de l'envoi d'un SMS (envoyé ou échec). -->
        <receiver
            android:name="io.element.android.features.sms.impl.SmsSentReceiver"
            android:exported="false" />

        <!-- 3. Écran de rédaction, ouvert par les autres apps (ex. "Envoyer un SMS" depuis les contacts). -->
        <activity
            android:name="io.element.android.features.sms.impl.ComposeSmsActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- 4. Réponse rapide par SMS quand on refuse un appel. -->
        <service
            android:name="io.element.android.features.sms.impl.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

    </application>
</manifest>
